    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "All observed TiTiler API endpoint groups in the selected time range, sorted by request count. Known dynamic routes are normalized; unmapped routes show their actual path without query strings. Legacy catch-all entries are recovered from logged URLs when available; entries without a URL are marked Unknown endpoint (legacy log).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "decimals": 0,
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sort_desc(sum by (endpoint) (count_over_time({service_name=\"nginx\"} | json traffic=\"traffic\", endpoint=\"endpoint\", request_url=\"request_url\" | traffic=\"api\" | label_format endpoint=`{{ if eq .endpoint \"other_api\" }}{{ if .request_url }}{{ regexReplaceAll \"[?].*\" (regexReplaceAll \"^https?://[^/]+\" .request_url \"\") \"\" }}{{ else }}Unknown endpoint (legacy log){{ end }}{{ else }}{{ .endpoint }}{{ end }}` | drop request_url [$__range])))",
          "legendFormat": "{{endpoint}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "API Endpoints (Selected Time Range)",
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Metric": 0,
              "Value": 1
            },
            "renameByName": {
              "Metric": "API",
              "Value": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "type": "table"
    },
