    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Twenty slowest individual Nginx-completed API requests with request_time strictly greater than 1 second in the selected time range. The duration filter runs before creating per-request series, reducing Loki query cardinality; fewer than 20 qualifying requests yield fewer rows. Duration includes cache, upstream work and response transmission. Ties remain separate requests. Full URLs appear only for events logged after the URL field was enabled; query strings may include signed raster URLs. Only retained logs (7 days) are available; ranges with over 10,000 qualifying requests can still exceed Loki's series limit.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "URL"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 600
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 12,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sort_desc(topk(20, max_over_time({service_name=\"nginx\"} | json traffic=\"traffic\", timestamp=\"timestamp\", client_ip=\"client_ip\", method=\"method\", endpoint=\"endpoint\", request_url=\"request_url\", status=\"status\", delivery_source=\"delivery_source\", request_time=\"request_time\" | traffic=\"api\" | request_time > 1 | label_format endpoint=`{{ if eq .endpoint \"other_api\" }}{{ if .request_url }}{{ regexReplaceAll \"[?].*\" (regexReplaceAll \"^https?://[^/]+\" .request_url \"\") \"\" }}{{ else }}Unknown endpoint (legacy log){{ end }}{{ else }}{{ .endpoint }}{{ end }}` | label_format event_id=`{{ unixEpochNanos __timestamp__ }}:{{ __line__ }}` | unwrap request_time | __error__=\"\" [$__range]) by (event_id, timestamp, client_ip, method, endpoint, request_url, status, delivery_source)))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top 20 Slowest Requests (>1s)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "event_id": true
            },
            "indexByName": {
              "Value #A": 0,
              "timestamp": 1,
              "request_url": 2,
              "endpoint": 3,
              "status": 4,
              "delivery_source": 5,
              "client_ip": 6,
              "method": 7
            },
            "renameByName": {
              "Value #A": "Duration",
              "timestamp": "Completed",
              "client_ip": "Client IP",
              "method": "Method",
              "endpoint": "Endpoint",
              "request_url": "URL",
              "status": "Status",
              "delivery_source": "Delivery"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
